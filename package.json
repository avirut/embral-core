{
  "name": "embral",
  "version": "0.4.1",
  "description": "Meeting transcription and notes, on your machine.",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "dev:cloud": "cross-env VITE_EMBRAL_CLOUD=1 tauri dev --features cloud",
    "build:cloud": "cross-env VITE_EMBRAL_CLOUD=1 tauri build --features cloud",
    "build:mcpb": "node scripts/build-mcpb.mjs",
    "render:icons": "node scripts/render-icons.mjs"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "~2.7.1",
    "@tauri-apps/plugin-notification": "^2.3.3",
    "@tauri-apps/plugin-opener": "^2",
    "@tauri-apps/plugin-process": "^2.3.1",
    "@tauri-apps/plugin-updater": "^2.10.1",
    "@tiptap/core": "^2.10.0",
    "@tiptap/pm": "2.27.2",
    "@tiptap/starter-kit": "^2.10.0",
    "clsx": "^2.1.1",
    "lucide-svelte": "^1.0.1",
    "tailwind-merge": "^3.5.0",
    "tailwind-variants": "^3.2.2",
    "tiptap-markdown": "^0.8.10",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "^2.1.2",
    "@internationalized/date": "^3.12.2",
    "@lucide/svelte": "^1.23.0",
    "@resvg/resvg-js": "^2.6.2",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tailwindcss/typography": "^0.5.19",
    "@tailwindcss/vite": "^4.1.18",
    "@tauri-apps/cli": "^2",
    "bits-ui": "^2.18.1",
    "cross-env": "^10.1.0",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "tailwindcss": "^4.1.18",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^3.0.0"
  }
}
